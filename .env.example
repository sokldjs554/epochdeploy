EPOCHDEPLOY_DATABASE_URL=sqlite:///./epochdeploy.db
# Production example:
# EPOCHDEPLOY_DATABASE_URL=postgresql+psycopg://epochdeploy:epochdeploy@postgres:5432/epochdeploy
EPOCHDEPLOY_JWT_SECRET=change-me-in-production
EPOCHDEPLOY_GITLAB_WEBHOOK_TOKEN=local-demo-token
EPOCHDEPLOY_EXECUTOR_URL=http://127.0.0.1:9080
EPOCHDEPLOY_EXECUTOR_MODE=http
EPOCHDEPLOY_EXECUTOR_HMAC_SECRET=local-executor-secret
EPOCHDEPLOY_CAPABILITY_SECRET=local-capability-secret-change-me-32bytes
EPOCHDEPLOY_UPLOAD_DIR=./var/evidence
EPOCHDEPLOY_MAX_UPLOAD_BYTES=5242880
EPOCHDEPLOY_MAX_WEBHOOK_BYTES=1048576
EPOCHDEPLOY_DEMO_MODE=true
